# Anthropic API 키 (ant auth login 프로필을 쓰면 비워 두어도 됩니다)
ANTHROPIC_API_KEY=

# 사용할 모델 (기본값: claude-opus-5-5)
DAI_MODEL=claude-opus-5-5
# 추론 깊이: low | medium | high | xhigh | max
DAI_EFFORT=high
# 응답 최대 토큰
DAI_MAX_TOKENS=16000
# 한 턴에서 허용하는 최대 도구 호출 반복 횟수
DAI_MAX_ITERATIONS=12

# 서버측 안전장치 폴백 (default | off). Claude API 직결이 아닌 환경(Bedrock/Vertex 등)에서는 off
DAI_FALLBACKS=default

# 비서가 다룰 수 있는 최대 비밀 등급: UNCLASSIFIED | RESTRICTED | CONFIDENTIAL | SECRET | TOP_SECRET
# (기본값 RESTRICTED = 대외비까지. 그 이상 표기가 감지되면 모델 호출 전에 차단)
DAI_MAX_CLASSIFICATION=RESTRICTED

# 민감정보 마스킹: mask | off
DAI_REDACTION=mask

# 지식 베이스 문서 디렉터리와 감사 로그 경로
DAI_DOCS_DIR=data/docs
DAI_GLOSSARY_PATH=data/glossary.json
DAI_AUDIT_LOG=audit/audit.jsonl
