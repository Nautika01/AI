# Anthropic API 키 (ant auth login 프로필을 쓰면 비워 두어도 됩니다)
ANTHROPIC_API_KEY=

# 모델 백엔드: claude (Anthropic API) | local (망 분리용 로컬 모델 서버)
DAI_BACKEND=claude

# [claude] 사용할 모델 (기본값: claude-opus-5-5)
DAI_MODEL=claude-opus-5-5
# 추론 깊이: low | medium | high | xhigh | max
DAI_EFFORT=high
# 응답 최대 토큰
DAI_MAX_TOKENS=16000
# 한 턴에서 허용하는 최대 도구 호출 반복 횟수
DAI_MAX_ITERATIONS=12

# 서버측 안전장치 폴백 (default | off). Claude API 직결이 아닌 환경(Bedrock/Vertex 등)에서는 off
DAI_FALLBACKS=default

# 비서가 다룰 수 있는 최대 비밀 등급: UNCLASSIFIED | RESTRICTED | CONFIDENTIAL | SECRET | TOP_SECRET
# (기본값 RESTRICTED = 대외비까지. 그 이상 표기가 감지되면 모델 호출 전에 차단)
DAI_MAX_CLASSIFICATION=RESTRICTED

# 민감정보 마스킹: mask | off
DAI_REDACTION=mask

# 지식 베이스 문서 디렉터리와 감사 로그 경로
DAI_DOCS_DIR=data/docs
DAI_GLOSSARY_PATH=data/glossary.json
DAI_AUDIT_LOG=audit/audit.jsonl

# ---- 검색 ----
# 동의어 사전과 임베딩 캐시
DAI_SYNONYMS_PATH=data/synonyms.json
DAI_INDEX_CACHE_DIR=storage/index
# 의미 검색: hash(모델 불필요, 기본) | openai(Ollama 등 /v1/embeddings 서버) | off(어휘 검색만)
DAI_EMBEDDINGS=hash
DAI_EMBEDDINGS_BASE_URL=http://127.0.0.1:11434/v1
DAI_EMBEDDINGS_MODEL=nomic-embed-text
DAI_EMBEDDINGS_API_KEY=

# ---- 서버 운영 (defense-ai serve) ----
# 사용자·토큰·대화 기록을 저장하는 SQLite 파일
DAI_DB_PATH=storage/defense.db
# 로그인 토큰 유효 시간(시간)
DAI_TOKEN_TTL_HOURS=12
# 로그인 실패 제한: N회 실패 시 M분 잠금
DAI_LOGIN_MAX_ATTEMPTS=5
DAI_LOGIN_LOCKOUT_MINUTES=10
# 웹 UI를 다른 도메인에서 띄울 때만 허용 출처를 쉼표로 지정 (기본: 같은 출처만)
DAI_CORS_ORIGINS=
# 최초 기동 시 사용자가 한 명도 없으면 이 비밀번호로 admin 계정을 자동 생성 (생성 후 비워 둘 것)
DAI_ADMIN_PASSWORD=

# ---- 로컬 모델 (DAI_BACKEND=local) ----
# OpenAI 호환 주소. Ollama 기본값은 http://127.0.0.1:11434/v1, vLLM/llama-server 는 http://호스트:포트/v1
DAI_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
# 모델 이름 (Ollama: `ollama list` 에 보이는 이름). 한국어는 exaone3.5:7.8b, qwen2.5:7b 등 권장
DAI_LOCAL_MODEL=qwen2.5:7b
# 서버가 인증을 요구할 때만 (vLLM --api-key 등)
DAI_LOCAL_API_KEY=
# 함수 호출(도구) 사용: auto(지원하면 사용, 아니면 자동으로 끔) | off
DAI_LOCAL_TOOLS=auto
# 매 턴 질문에 붙여 주는 참고 문서 수
DAI_LOCAL_RAG_TOP_K=4
# 응답 대기 시간(초), 생성 온도
DAI_LOCAL_TIMEOUT=300
DAI_LOCAL_TEMPERATURE=0.2
